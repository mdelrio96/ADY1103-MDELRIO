#!/bin/bash
# ---------------------------------------------------------------------------
# Arranque de andys-monitoreo (Amazon Linux 2023).
#
# Deja la máquina lista para instalar el stack a mano: Docker, plugin Compose,
# git y python3 (para generar_trafico.py), más 2 GB de swap. No instala
# Prometheus ni Grafana: esa instalación es parte de la evaluación.
#
# Log: /var/log/cloud-init-output.log   ·   Fin: /home/ec2-user/.bootstrap-listo
# ---------------------------------------------------------------------------
set -euxo pipefail

COMPOSE_VERSION=v2.29.7

dnf update -y
dnf install -y docker git python3 jq
systemctl enable --now docker
usermod -aG docker ec2-user

CLI_PLUGINS=/usr/local/lib/docker/cli-plugins
mkdir -p "$CLI_PLUGINS"
curl -fsSL "https://github.com/docker/compose/releases/download/$COMPOSE_VERSION/docker-compose-linux-x86_64" \
  -o "$CLI_PLUGINS/docker-compose"
chmod +x "$CLI_PLUGINS/docker-compose"

# Swap: evita que Prometheus o Grafana mueran por memoria en una t3.small.
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=2048
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
fi

# Direcciones privadas de la plataforma, a mano para escribir prometheus.yml.
cat > /etc/profile.d/andys.sh <<ENV
export ANDYS_APP=${ip_app}
export ANDYS_BORDE=${ip_borde}
ENV

touch /home/ec2-user/.bootstrap-listo
chown ec2-user:ec2-user /home/ec2-user/.bootstrap-listo
